# Skopiuj do .env (plik .env jest w .gitignore) i zmień, co potrzebne.

# --- docker-compose: porty na Twoim komputerze (zmień, gdy np. masz już lokalnego PostgreSQL) ---
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- praca bez Dockera (audytor-api, celery, alembic uruchamiane z .venv) ---
# Wczytanie w PowerShell:  Get-Content .env | ForEach-Object { if ($_ -match '^(AUDYTOR_\w+)=(.*)$') { Set-Item "env:$($matches[1])" $matches[2] } }
# Wczytanie w bash:        set -a; source .env; set +a
AUDYTOR_DB_URL=postgresql+psycopg://audytor:audytor@localhost:5432/audytor
AUDYTOR_REDIS_URL=redis://localhost:6379/0
AUDYTOR_WYNIKI_DIR=wyniki
# Przeglądarka z systemu zamiast Chromium z Playwrighta: chrome albo msedge (puste = Chromium)
AUDYTOR_PRZEGLADARKA=
AUDYTOR_TIMEOUT_S=30
# Pauza między podstronami tej samej witryny w skanie (s)
AUDYTOR_OPOZNIENIE_S=1
